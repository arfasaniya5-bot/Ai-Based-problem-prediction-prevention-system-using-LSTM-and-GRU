# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python virtual environment and cache
backend/.venv/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Backend dataset files (prevent large CSV/data files from Git tracking)
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
*.csv
*.parquet
*.h5
*.pkl

# Databases and test artifacts
*.db
*.sqlite
*.sqlite3
.pytest_cache/

# Local environment configuration
.env
.env*.local
!.env.example


# Additional generated filies and trained models
backend/ .venv/
*.joblib
.env.*
cat >> .gitignore << 'EOF'
# Additional generated filies and trained models
backend/ .venv/
*.joblib
.env
.env.*
!.env.example
